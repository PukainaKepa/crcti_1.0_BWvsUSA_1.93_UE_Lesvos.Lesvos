; args: [vehicle, type, si]

_v = _this select 0

~1
? !(local _v) || !(alive _v) : exit

_mags = magazines _v
_wpns = weapons _v
{ _v removeMagazine _x} foreach _mags
{ _v removeWeapon _x} foreach _wpns

_v addMagazine "DVD_KA50AP";
_v addMagazine "DVD_KA50HE";
_v addMagazine "DVD_AT6_KA50";
_v addWeapon "DVD_KA50AP";
_v addWeapon "DVD_AT6_KA50";

