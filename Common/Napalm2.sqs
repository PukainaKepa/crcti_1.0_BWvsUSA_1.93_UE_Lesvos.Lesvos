_Missile =  _this select 0

@GetDammage _Missile>= 0.35;

_Upos= GetPos _Missile;

#End
_ux=_Upos Select 0;
_uy=_Upos Select 1;
_uz=_Upos Select 2;

_count = 0
_k = 200
_k2 = _k/2
	;_text = format["(`·..·´) Napalm Truck has been destroyed (`·..·´)"]
	;Player Globalchat _text
#start
_count = _count + 1
_Rndx = Random _k
_Rndx2 = _Rndx -_k2
_Rndy = Random _k
_Rndy2 = _Rndy -_k2
_LaserGuidedBomb="shell125" CamCreate [_ux+_Rndx2,_uy+_Rndy2,0];
;_LaserGuidedBomb="LaserGuidedBomb" CamCreate [_ux+_Rndx2,_uy+_Rndy2,0];
;Player Globalchat format["%1 %2",_Rndx2,_Rndy2]
~.01
?(_count > 200):exit
goto "start"
exit