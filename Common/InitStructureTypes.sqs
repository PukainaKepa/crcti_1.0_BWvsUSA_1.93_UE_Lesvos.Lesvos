structMatrix = [ [], [] ]
structsBuilt = [ [], [] ]

_index = 0
_count = count structDefs

#InitStructs
	(structMatrix select si0) set [_index, []]	
	(structMatrix select si1) set [_index, []]	

	(structsBuilt select si0) set [_index, 0]	
	(structsBuilt select si1) set [_index, 0]	

	_index = _index + 1
	? (_index < _count): goto "InitStructs"

structsRespawn = [stComm, stBarracks, stLight, stHeavy, stAir, stAir2]
structsCritcal = [stComm, stBarracks, stLight, stHeavy, stAir, stAir2]

; do server stuff only
? !(local LocalServerObject) : Exit

; BASE TEMPLATES

; format [type, timeBuild, posRelMhq, dirBuilder]
; dirBuilder is the direction the builder faces when building the structure relative to the MHQ

bdType = 0
bdTime = 1
bdPos = 2
bdDir = 3

baseDefs = []

_base = []
_prims = []
_prims set [count _prims, [stLight, 1, [-11, 18], 90] ]
_prims set [count _prims, [stHeavy, 0, [7, 18], 180] ]
_prims set [count _prims, [stComm, 1, [0, -16], 270] ]
