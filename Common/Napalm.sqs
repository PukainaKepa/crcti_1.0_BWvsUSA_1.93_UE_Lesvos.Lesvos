; args: [vehicle, type, si]

_v = _this select 0

~1
? !(local _v) || !(alive _v) : exit

#start
~1
_Driver = Driver _v
?!(alive _v):exit
?!(alive _Driver):goto "start"
  ;_msg = "This is Napalm Truck. Get dammage = explosion"
  ;? _Driver == player : hint _msg
  ;_Driver sidechat _msg
#start2
~1
_Driver = Driver _v
?!(alive _v):exit
?!(alive _Driver):goto "start"
goto "start2"
